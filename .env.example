# ============================================================================
# EchoMind (https://github.com/zhaimingyou/EchoMind) - Environment Config
# ============================================================================

# --- 1. Server & Runtime ---
APP_NAME=EchoMind
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# --- 2. Pluggable Providers ---
# Options: "sherpa_onnx" (pure CPU local) or "mock" (for fast CI/testing)
ASR_PROVIDER=sherpa_onnx
SPEAKER_PROVIDER=sherpa_onnx

# --- 3. Voiceprint & VAD Parameters ---
HOST_SIMILARITY_THRESHOLD=0.65
GUEST_CLUSTER_THRESHOLD=0.60
SHORT_UTTERANCE_MS=1200
INHERIT_SPEAKER_WINDOW_SEC=3.0

# --- 4. Episode Segmenter State Machine ---
SILENCE_SPLIT_SECONDS=180
MAX_EPISODE_DURATION_SECONDS=1500
OVERLAP_CONTEXT_UTTERANCES=5
MEETING_BYSTANDER_MODE=false

# --- 5. Cognitive LLM Engine (Compatible with DeepSeek / Qwen / OpenAI / Ollama) ---
# Set LLM_PROVIDER="mock" to use built-in deterministic heuristic extraction without API keys
LLM_MODEL=deepseek/deepseek-chat
LLM_API_KEY=your_api_key_here
LLM_API_BASE=https://api.deepseek.com/v1

# --- 6. Proactive Daily Memo Schedule ---
MORNING_MEMO_CRON_HOUR=8
MORNING_MEMO_CRON_MINUTE=30
EVENING_MEMO_CRON_HOUR=21
EVENING_MEMO_CRON_MINUTE=30

# --- 7. Connectors & Storage ---
DATA_DIR=./data
MODELS_DIR=./models
OBSIDIAN_SYNC_ENABLED=true
WEBHOOK_URL=
